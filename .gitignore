# ============================================================
# Drawing Auto Comparison (Web) - .gitignore
# 위치: 프로젝트 맨 위 폴더 (DrawingAutoComparison.bat 옆)
# ============================================================

# ---------- 자동 생성 (npm install / npm run build 로 다시 만들어짐)
node_modules/
.next/
frontend/out/
*.tsbuildinfo
npm-debug.log*

# ---------- Python 자동 생성
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ---------- 사내 자료 (절대 올리지 않음)
# 업로드한 도면·비교 결과·판정 기록
backend/data/
# 회귀 테스트용 사내 도면과 그 Hash
samples/*.pdf
backend/tests/baseline/*.json
# 실수로 도면이 섞이는 것 방지
*.pdf

# ---------- 개인 설정
compare_drawings_overlay_settings.json
.env.local
.env

# ---------- 편집기·OS 임시 파일
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 예외: 안내 파일은 올림
!samples/README.txt
!backend/tests/baseline/README.txt
